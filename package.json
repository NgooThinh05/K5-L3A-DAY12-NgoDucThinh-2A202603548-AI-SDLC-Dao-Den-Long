{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — 3D game & deterministic headless simulation (Day 12 AI SDLC Lab · v1.0.0)",
  "scripts": {
    "dev": "vite",
    "start": "node dist/run.js",
    "build:headless": "esbuild src/sim/headless.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/headless.js",
    "build:cli": "esbuild src/sim/run.ts src/sim/bench.ts src/sim/soak.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist",
    "build:web": "vite build",
    "build": "npm run typecheck && npm run build:headless && npm run build:cli && npm run build:web",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:headless && npm run build:cli && node --import tsx tests/contract.test.ts",
    "bench": "node dist/bench.js --seed 42 --duration 30 --out bench.json",
    "soak": "node dist/soak.js --seed 7 --nights 10 --out soak.json",
    "verify": "npm run build && npm test"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
